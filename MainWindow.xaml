<Window x:Class="Pokedex.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pokedex"
        xmlns:viewmodels="clr-namespace:Pokedex.viewmodels" 
        xmlns:views="clr-namespace:Pokedex.views"
        mc:Ignorable="d"
        Title="Pokémon Manager" Height="768" Width="1336"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA">
    <Window.Resources>

        <DataTemplate DataType="{x:Type viewmodels:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type viewmodels:PokedexViewModel}">
            <views:PokedexView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:RegisterPokemonViewModel}">
            <views:PokemonRegisterView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:TrainerRegisterViewModel}">
            <views:TrainerRegisterView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:TrainerListViewModel}">
            <views:TrainerListView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#FAFAFA" CornerRadius="0 20 20 0">
            <Grid>
                <StackPanel Margin="20" VerticalAlignment="Center">

                    <Button Content="Home" Style="{StaticResource HomeButtonStyle}" 
                            Command="{Binding ShowHomeCommand}"/>

                    <Button Content="Pokedex" Style="{StaticResource PokedexButtonStyle}" 
                            Command="{Binding ShowPokedexCommand}" Margin="0,50,0,0"/>

                    <Button Content="Register Pokemon" Style="{StaticResource PokemonButtonStyle}" 
                            Command="{Binding ShowRegisterPokemonCommand}" Margin="0,50,0,0"/>

                    <Button Content="Register Trainer" Style="{StaticResource TrainerButtonStyle}" 
                            Command="{Binding ShowRegisterTrainerCommand}" Margin="0,50,0,0"/>

                    <Button Content="Trainers &amp; Teams" Style="{StaticResource TeamButtonStyle}" 
                            Command="{Binding ShowTrainerListCommand}" Margin="0,50,0,0"/>
                </StackPanel>

                <TextBlock Text="v2.0 - SQLite Edition" Foreground="#FFCCCC" 
                           VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="10"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="20">
            <ContentControl Content="{Binding CurrentView}" />
        </Grid>
    </Grid>
</Window>