<Window x:Class="Pokedex.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pokedex"
        mc:Ignorable="d"
        Title="Pokémon Manager" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA">
    <Window.Resources>
        <Style x:Key="PokedexButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#CC0000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Style.Resources>
        </Style>
        <Style x:Key="PokemonButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3F51B5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Style.Resources>
        </Style>
        <Style x:Key="TrainerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFC107"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Style.Resources>
        </Style>
        <Style x:Key="TeamButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#FAFAFA" CornerRadius="0 20 20 0">
            <Grid>
                <StackPanel Margin="20">
                    <TextBlock Text="POKÉDEX" FontSize="28" FontWeight="Bold" 
                               Foreground="#212121" Margin="0,0,0,40" HorizontalAlignment="Center"/>

                    <Button Content="Ver Pokedéx" Style="{StaticResource PokedexButtonStyle}" 
                            Command="{Binding ShowPokedexCommand}"/>

                    <Button Content="Registrar Pokémon" Style="{StaticResource PokemonButtonStyle}" 
                            Command="{Binding ShowRegisterPokemonCommand}" Margin="0,10,0,0"/>

                    <Button Content="Registrar Treinador" Style="{StaticResource TrainerButtonStyle}" 
                            Command="{Binding ShowRegisterTrainerCommand}" Margin="0,10,0,0"/>

                    <Button Content="Treinadores &amp; Times" Style="{StaticResource TeamButtonStyle}" 
                            Command="{Binding ShowTrainerListCommand}" Margin="0,10,0,0"/>
                </StackPanel>

                <TextBlock Text="v2.0 - SQLite Edition" Foreground="#FFCCCC" 
                           VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="10"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="20">
            <ContentControl Content="{Binding CurrentView}" />
        </Grid>
    </Grid>
</Window>