<Window x:Class="Pokedex.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pokedex"
        xmlns:viewmodels="clr-namespace:Pokedex.viewmodels" 
        xmlns:views="clr-namespace:Pokedex.views"
        mc:Ignorable="d"
        Title="Pokémon Manager" Height="768" Width="1336"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" 
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackground}" MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:PokedexViewModel}">
            <views:PokedexView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:PokemonRegisterViewModel}">
            <views:PokemonRegisterView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:TrainerRegisterViewModel}">
            <views:TrainerRegisterView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:TrainerListViewModel}">
            <views:TrainerListView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource ColorSurface}" CornerRadius="0 20 20 0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.05" Direction="0"/>
            </Border.Effect>

            <Grid>
                <StackPanel Margin="20" VerticalAlignment="Center">

                    <Button Content="Home" 
                Style="{StaticResource MaterialButton}" 
                Background="{DynamicResource ColorHome}" 
                Foreground="{DynamicResource ColorHomeText}" 
                Command="{Binding ShowHomeCommand}"/>

                    <Button Content="Pokedex" 
                            Style="{StaticResource MaterialButton}" 
                            Background="{DynamicResource ColorPokedex}" 
                            Command="{Binding ShowPokedexCommand}" Margin="0,30,0,0"/>

                    <Button Content="Register Pokemon" 
                            Style="{StaticResource MaterialButton}" 
                            Background="{DynamicResource ColorPokemon}" 
                            Command="{Binding ShowRegisterPokemonCommand}" Margin="0,30,0,0"/>

                    <Button Content="Register Trainer" 
                            Style="{StaticResource MaterialButton}" 
                            Background="{DynamicResource ColorTrainer}" 
                            Command="{Binding ShowRegisterTrainerCommand}" Margin="0,30,0,0"/>

                    <Button Content="Trainers &amp; Teams" 
                            Style="{StaticResource MaterialButton}" 
                            Background="{DynamicResource ColorTeam}" 
                            Command="{Binding ShowTrainerListCommand}" Margin="0,30,0,0"/>

                    <Button Content="Close App" 
                            Click="btnClose_Click" 
                            Margin="0,50,0,0" 
                            Background="Transparent" 
                            Foreground="{DynamicResource ColorBorder}" 
                            BorderThickness="0" 
                            FontSize="15" 
                            FontWeight="Bold" 
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource ColorPokedex}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="🌗 Toggle Theme" 
                            Click="btnTheme_Click" 
                            Margin="0,15,0,0" 
                            Background="Transparent" 
                            Foreground="{DynamicResource TextColorSecondary}" 
                            BorderThickness="0" 
                            FontSize="14" 
                            FontWeight="Bold" 
                            Cursor="Hand"/>
                </StackPanel>

                <TextBlock Text="v2.0 - Material Edition" Foreground="{DynamicResource ColorBorder}" 
                           VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="10" FontSize="11" FontWeight="SemiBold"/>
            </Grid>
        </Border>
        
        

        <Grid Grid.Column="1" Margin="20">
            <ContentControl Content="{Binding CurrentView}" />
        </Grid>
    </Grid>
</Window>