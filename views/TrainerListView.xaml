<UserControl x:Class="Pokedex.views.TrainerListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:services="clr-namespace:Pokedex.services"
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="1366"
             Background="Transparent">

    <UserControl.Resources>
        <services:AbsoluteFilePathConverter x:Key="AbsoluteFilePathConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="15,20,15,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="15" Padding="15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.1"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="T R A I N E R S" FontSize="18" FontWeight="Black" Foreground="#2C2C2E" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                <ListBox x:Name="lstTrainers" Grid.Row="1" Background="Transparent" BorderThickness="0" 
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemsSource="{Binding Trainers}"
                         SelectedItem="{Binding SelectedTrainer}">

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="TrainerCard" Background="#F8F8FA" CornerRadius="6" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" FontWeight="Black" Foreground="#333" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>

                                    <TextBlock Grid.Column="1" Text="{Binding Game}" FontSize="11" FontWeight="Bold" Foreground="#888" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>

                                    <Border Grid.Column="2" x:Name="BadgeRegion" Background="#E5E5EA" CornerRadius="4" Padding="6,3" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtRegion" Text="{Binding Region}" FontSize="10" FontWeight="Bold" Foreground="#555" HorizontalAlignment="Center"/>
                                    </Border>

                                    <Border Grid.Column="3" x:Name="BadgeId" Background="#E5E5EA" CornerRadius="4" Padding="6,3" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtId" Text="{Binding TrainerId, StringFormat='ID: {0}'}" FontSize="10" FontWeight="Bold" Foreground="#555" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=IsSelected}" Value="True">
                                    <Setter TargetName="TrainerCard" Property="Background" Value="#B9F6CA"/>
                                    <Setter TargetName="BadgeRegion" Property="Background" Value="#00E676"/>
                                    <Setter TargetName="BadgeId" Property="Background" Value="#00E676"/>
                                    <Setter TargetName="TxtRegion" Property="Foreground" Value="#111111"/>
                                    <Setter TargetName="TxtId" Property="Foreground" Value="#111111"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Column="2" Background="White" CornerRadius="15" Padding="15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.1"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="txtTrainerName" 
           Text="{Binding SelectedTrainer.Name, FallbackValue='SELECT A TRAINER', StringFormat={}{0}’S TEAM}" 
           FontSize="20" FontWeight="Black" Foreground="#2C2C2E" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="icPokemons" ItemsSource="{Binding Pokemons}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="145" Height="190" Background="#F8F8FA" CornerRadius="10" Margin="8" Cursor="Hand" MouseLeftButtonUp="PokemonCard_Click" Padding="10">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.08"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <TextBlock Text="{Binding Dex, StringFormat='#{0}'}" FontSize="11" FontWeight="Bold" Foreground="#999" HorizontalAlignment="Left"/>
                                            <TextBlock Text="🌟" Foreground="#FFD700" FontSize="11" HorizontalAlignment="Center" Visibility="{Binding IsShiny, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding Level, StringFormat='Lv. {0}'}" FontSize="11" FontWeight="Black" Foreground="#E3350D" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <TextBlock Grid.Row="1" Text="{Binding Species}" FontSize="9" FontWeight="Bold" Foreground="#AAA" Margin="0,2,0,0" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"/>

                                        <Image Grid.Row="2" Source="{Binding ImagePath, Converter={StaticResource AbsoluteFilePathConverter}}" Stretch="Uniform" Margin="2"/>

                                        <TextBlock Grid.Row="3" Text="{Binding DisplayName}" FontSize="12" FontWeight="Black" Foreground="#333" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>