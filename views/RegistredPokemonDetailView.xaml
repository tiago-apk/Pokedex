<Window x:Class="Pokedex.views.RegisteredPokemonDetailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Pokedex.services"
        Title="Pokémon Status" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackground}">

    <Window.Resources>
        <services:AbsoluteFilePathConverter x:Key="AbsoluteFilePathConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="20">
        <Border Background="{DynamicResource ColorSurface}" CornerRadius="20" Padding="25">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.1"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnPrev" Grid.Column="0" Content="◀" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextColorSecondary}" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="btnPrev_Click" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource ColorPokedex}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock Grid.Column="1" Text="{Binding HeaderTitle}" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextColorPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <Button x:Name="btnNext" Grid.Column="2" Content="▶" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextColorSecondary}" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="btnNext_Click" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource ColorPokedex}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="1.6*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource ColorSurfaceVariant}" CornerRadius="15" Padding="20">
                        <StackPanel VerticalAlignment="Center">
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="{Binding BaseDex.Dex, StringFormat='#{0}'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextColorSecondary}" HorizontalAlignment="Left"/>

                                <TextBlock Text="🌟 SHINY" Foreground="#FFD700" FontSize="14" FontWeight="Black" HorizontalAlignment="Center" 
                                           Visibility="{Binding Pokemon.IsShiny, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <TextBlock Text="{Binding Pokemon.Level, StringFormat='Lv. {0}'}" FontSize="16" FontWeight="Black" Foreground="{DynamicResource ColorPokedexAccent}" HorizontalAlignment="Right"/>
                            </Grid>

                            <Image Source="{Binding ImagePath, Converter={StaticResource AbsoluteFilePathConverter}}" Height="200" Stretch="Uniform" Margin="0,10,0,15"/>

                            <TextBlock Text="{Binding DisplayNickname}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextColorPrimary}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                            <TextBlock Text="{Binding Pokemon.BasePokemon}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextColorSecondary}" HorizontalAlignment="Center" Margin="0,5,0,15"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="NATURE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextColorSecondary}"/>
                                    <Border Background="{DynamicResource ColorBorder}" CornerRadius="6" Padding="10,8" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Pokemon.Nature}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextColorPrimary}" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="ABILITY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextColorSecondary}"/>
                                    <Border Background="{DynamicResource ColorBorder}" CornerRadius="6" Padding="10,8" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Pokemon.Ability}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextColorPrimary}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2">
                        <Grid Margin="0,0,0,10" Cursor="Hand" MouseLeftButtonUp="Stats_Click" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding ChartTitle}" FontSize="15" FontWeight="Black" Foreground="{DynamicResource TextColorPrimary}"/>
                        </Grid>

                        <Border Background="{DynamicResource ColorSurfaceVariant}" CornerRadius="20" Padding="10" Cursor="Hand" MouseLeftButtonUp="Stats_Click" Height="290">
                            <Grid Width="280" Height="280" HorizontalAlignment="Center" VerticalAlignment="Center">

                                <Polygon Points="140,40 226.6,90 226.6,190 140,240 53.4,190 53.4,90" Stroke="{DynamicResource ColorBorder}" StrokeThickness="2" Fill="Transparent"/>
                                <Polygon Points="140,90 183.3,115 183.3,165 140,190 96.7,165 96.7,115" Stroke="{DynamicResource ColorBorder}" StrokeThickness="1" Fill="Transparent"/>
                                <Path Stroke="{DynamicResource ColorBorder}" StrokeThickness="1" Data="M140,140 L140,40 M140,140 L226.6,90 M140,140 L226.6,190 M140,140 L140,240 M140,140 L53.4,190 M140,140 L53.4,90"/>

                                <Polygon Points="{Binding HexagonPointsString}"
                                         Fill="{Binding ChartFillColor}"
                                         Stroke="{Binding ChartStrokeColor}"
                                         StrokeThickness="2" Opacity="0.75"/>

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0">
                                    <TextBlock Text="HP" FontSize="12" FontWeight="Bold" Foreground="#FF5959" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding AllStats[0].NatureSymbol}" Foreground="{Binding AllStats[0].SymbolColor}" FontWeight="Black" FontSize="12" Margin="0,0,2,0"/>
                                        <TextBlock Text="{Binding AllStats[0].DisplayValue}" FontSize="13" FontWeight="Black" Foreground="{DynamicResource TextColorPrimary}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,60,-10,0">
                                    <TextBlock Text="Attack" FontSize="12" FontWeight="Bold" Foreground="#F5AC78" HorizontalAlignment="Left"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding AllStats[1].NatureSymbol}" Foreground="{Binding AllStats[1].SymbolColor}" FontWeight="Black" FontSize="12" Margin="0,0,2,0"/>
                                        <TextBlock Text="{Binding AllStats[1].DisplayValue}" FontSize="13" FontWeight="Black" Foreground="{DynamicResource TextColorPrimary}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-10,60">
                                    <TextBlock Text="Defense" FontSize="12" FontWeight="Bold" Foreground="#FAE078" HorizontalAlignment="Left"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding AllStats[2].NatureSymbol}" Foreground="{Binding AllStats[2].SymbolColor}" FontWeight="Black" FontSize="12" Margin="0,0,2,0"/>
                                        <TextBlock Text="{Binding AllStats[2].DisplayValue}" FontSize="13" FontWeight="Black" Foreground="{DynamicResource TextColorPrimary}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,0">
                                    <TextBlock Text="Speed" FontSize="12" FontWeight="Bold" Foreground="#FA92B2" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding AllStats[5].NatureSymbol}" Foreground="{Binding AllStats[5].SymbolColor}" FontWeight="Black" FontSize="12" Margin="0,0,2,0"/>
                                        <TextBlock Text="{Binding AllStats[5].DisplayValue}" FontSize="13" FontWeight="Black" Foreground="{DynamicResource TextColorPrimary}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-10,0,0,60">
                                    <TextBlock Text="Sp. Def" FontSize="12" FontWeight="Bold" Foreground="#A7DB8D" HorizontalAlignment="Right"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding AllStats[4].NatureSymbol}" Foreground="{Binding AllStats[4].SymbolColor}" FontWeight="Black" FontSize="12" Margin="0,0,2,0"/>
                                        <TextBlock Text="{Binding AllStats[4].DisplayValue}" FontSize="13" FontWeight="Black" Foreground="{DynamicResource TextColorPrimary}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-10,60,0,0">
                                    <TextBlock Text="Sp. Atk" FontSize="12" FontWeight="Bold" Foreground="#9DB7F5" HorizontalAlignment="Right"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding AllStats[3].NatureSymbol}" Foreground="{Binding AllStats[3].SymbolColor}" FontWeight="Black" FontSize="12" Margin="0,0,2,0"/>
                                        <TextBlock Text="{Binding AllStats[3].DisplayValue}" FontSize="13" FontWeight="Black" Foreground="{DynamicResource TextColorPrimary}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="M O V E S E T" FontSize="16" FontWeight="Black" Foreground="{DynamicResource TextColorSecondary}" Margin="0,15,0,10"/>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource ColorSurfaceVariant}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <TextBlock Text="{Binding DisplayMove1}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextColorPrimary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource ColorSurfaceVariant}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <TextBlock Text="{Binding DisplayMove2}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextColorPrimary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource ColorSurfaceVariant}" CornerRadius="8" Padding="12">
                                <TextBlock Text="{Binding DisplayMove3}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextColorPrimary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource ColorSurfaceVariant}" CornerRadius="8" Padding="12">
                                <TextBlock Text="{Binding DisplayMove4}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextColorPrimary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>

                <Button Grid.Row="2" Content="CLOSE" Click="btnClose_Click" HorizontalAlignment="Right"
                        Width="130" Height="40" Background="{DynamicResource ColorBorder}" Foreground="{DynamicResource TextColorPrimary}" 
                        Style="{StaticResource MaterialButton}" Margin="0,20,0,0" />

            </Grid>
        </Border>
    </Grid>
</Window>