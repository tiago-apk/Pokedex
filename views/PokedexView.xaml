<UserControl x:Class="Pokedex.views.PokedexView"
             x:Name="PokedexRoot" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:services="clr-namespace:Pokedex.services"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <services:TypeToBrushConverter x:Key="TypeToBrushConverter" />
        <services:TypeToIconConverter x:Key="TypeToIconConverter" />
        <services:AbsoluteFilePathConverter x:Key="AbsoluteFilePathConverter" />

        <FontFamily x:Key="PokeFont">pack://application:,,,/assets/PokemonIcons.ttf#PokemonIcons</FontFamily>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,10,0,5">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                <ItemsControl ItemsSource="{Binding Regions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.FilterByRegionCommand, ElementName=PokedexRoot}"
                                    CommandParameter="{Binding}"
                                    Margin="5" Padding="10,5" Background="{DynamicResource ColorSurface}" 
                                    Foreground="{DynamicResource TextColorPrimary}" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource PokeFont}" FontSize="16" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="{Binding CurrentRegionName}" FontSize="24" FontWeight="Black" 
                       Foreground="{DynamicResource TextColorPrimary}" Margin="20,0,0,10"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Pokemons}" Background="Transparent" BorderThickness="0">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center" ItemWidth="150" ItemHeight="200" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.OpenDetailCommand, ElementName=PokedexRoot}" 
                                CommandParameter="{Binding}" 
                                Background="Transparent" BorderBrush="Transparent" Cursor="Hand">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{DynamicResource ColorSurface}" CornerRadius="15" Margin="5" Width="140" Height="190">
                                        <StackPanel>
                                            <TextBlock Text="{Binding NationalDex, StringFormat='#{0:D4}'}" 
                                                       FontSize="12" Foreground="{DynamicResource TextColorSecondary}" 
                                                       Margin="10,10,10,0" FontWeight="Bold" HorizontalAlignment="Left"/>

                                            <Image Source="{Binding ImageNormal, Converter={StaticResource AbsoluteFilePathConverter}}" 
                                                   Height="90" Width="90" Margin="0,5"/>

                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" 
                                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextColorPrimary}" Margin="0,2"/>

                                            <ItemsControl ItemsSource="{Binding Types}" HorizontalAlignment="Center" Margin="0,5">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Image Source="{Binding TypeName, Converter={StaticResource TypeToIconConverter}}" 
                                                               Height="20" Width="20" Margin="3,0"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.8"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Opacity" Value="0.6"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>