<UserControl x:Class="Pokedex.views.PokedexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:services="clr-namespace:Pokedex.services"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <services:TypeToBrushConverter x:Key="TypeToBrushConverter" />
        <services:TypeToIconConverter x:Key="TypeToIconConverter" />
        <services:AbsoluteFilePathConverter x:Key="AbsoluteFilePathConverter" />

        <FontFamily x:Key="PokeFont">pack://application:,,,/assets/PokemonIcons.ttf#PokemonIcons</FontFamily>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,10,0,5">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                <ItemsControl ItemsSource="{Binding Regions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.FilterByRegionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Margin="8,0" Padding="10"
                                    Background="Transparent" 
                                    BorderThickness="0" 
                                    Cursor="Hand"
                                    Foreground="{DynamicResource TextColorSecondary}" 
                                    ToolTip="{Binding Name}">

                                <Button.Content>
                                    <TextBlock Text="{Binding Icon}" 
                                               FontFamily="{StaticResource PokeFont}"
                                               FontSize="24"/>
                                </Button.Content>

                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="10" 
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ColorSurfaceVariant}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource ColorPokedex}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Background="{DynamicResource ColorSurface}" CornerRadius="0,0,0,0" BorderBrush="{DynamicResource ColorBorder}" BorderThickness="0,1,0,0" Padding="20,5">
                <TextBlock Text="{Binding CurrentRegionName}" 
                           FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextColorPrimary}" 
                           HorizontalAlignment="Left" Margin="10,0"/>
            </Border>
        </StackPanel>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Pokemons}" 
                 SelectedItem="{Binding SelectedPokemon}"
                 Background="Transparent" 
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel HorizontalAlignment="Center" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Margin" Value="4"/>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{DynamicResource ColorSurface}" 
                                        BorderBrush="{Binding Types, Converter={StaticResource TypeToBrushConverter}}" 
                                        BorderThickness="3" 
                                        CornerRadius="15" 
                                        Width="140" Height="190">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.08"/>
                                    </Border.Effect>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Dex, StringFormat='#{0:D3}'}" 
                                                   FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextColorSecondary}" 
                                                   Margin="10,5,0,0" HorizontalAlignment="Left"/>

                                        <Image Source="{Binding Image, Converter={StaticResource AbsoluteFilePathConverter}}" 
                                               Height="80" Margin="0,5"/>

                                        <TextBlock Text="{Binding Name}" FontSize="14" 
                                                   FontWeight="Bold" HorizontalAlignment="Center" 
                                                   Foreground="{DynamicResource TextColorPrimary}" Margin="0,2"/>

                                        <ItemsControl ItemsSource="{Binding Types}" HorizontalAlignment="Center" Margin="0,5">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Image Source="{Binding Converter={StaticResource TypeToIconConverter}}" 
                                                           Height="18" Width="18" Margin="2,0"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>