<Window x:Class="Pokedex.views.PokemonDetailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:services="clr-namespace:Pokedex.services"
        mc:Ignorable="d"
        Title="{Binding Pokemon.Name, FallbackValue='Pokemon Data'}" Height="576" Width="1024"
        ResizeMode="NoResize" WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBackground}">

    <Window.Resources>
        <services:TypeToBrushConverter x:Key="TypeToBrushConverter" />
        <services:TypeToImageConverter x:Key="TypeToImageConverter" />
        <services:AbsoluteFilePathConverter x:Key="AbsoluteFilePathConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <services:StatsToPolygonConverter x:Key="StatsToPolygonConverter" />

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#44000000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="25">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-6,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#88000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{Binding Pokemon.Types, Converter={StaticResource TypeToBrushConverter}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.3"/>
            </Border.Effect>

            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Button Content="‹" HorizontalAlignment="Left" Click="PreviousForm_Click" Style="{StaticResource NavButtonStyle}" Visibility="{Binding HasMultipleForms, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="{Binding DisplayedImage, Converter={StaticResource AbsoluteFilePathConverter}}" 
                               Stretch="Uniform" Margin="50,10" MaxHeight="250">
                            <Image.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="10" Opacity="0.5"/>
                            </Image.Effect>
                        </Image>

                        <Image Source="{Binding MegaIconPath}" Width="35" Height="35" 
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,15,0,0"
                               Visibility="{Binding HasMegaEvolution, Converter={StaticResource BooleanToVisibilityConverter}}"
                               ToolTip="Mega Evolution">
                            <Image.Effect>
                                <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.6"/>
                            </Image.Effect>
                        </Image>

                        <Image Source="{Binding DynamaxIconPath}" Width="35" Height="35" 
                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,40,0"
                               Visibility="{Binding HasGigantamax, Converter={StaticResource BooleanToVisibilityConverter}}"
                               ToolTip="Gigantamax Form">
                            <Image.Effect>
                                <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.6"/>
                            </Image.Effect>
                        </Image>
                    </Grid>

                    <Button Content="›" HorizontalAlignment="Right" Click="NextForm_Click" Style="{StaticResource NavButtonStyle}" Visibility="{Binding HasMultipleForms, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>

                <TextBlock Grid.Row="1" Text="{Binding Pokemon.Description}" 
                           Foreground="White" FontSize="14" FontWeight="Medium" 
                           TextWrapping="Wrap" TextAlignment="Center" Margin="10,15,10,25"
                           Opacity="0.95"/>

                <StackPanel Grid.Row="2" Margin="0,0,0,10" Visibility="{Binding HasEvolution, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="EVOLUTION PATH" FontSize="11" FontWeight="Bold" Foreground="White" Opacity="0.7" HorizontalAlignment="Center" Margin="0,0,0,5"/>

                    <Grid HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="◀" Click="PrevEvoPath_Click" Style="{StaticResource NavButtonStyle}" Width="30" Height="30" FontSize="16"
                                Visibility="{Binding HasMultipleEvolutionPaths, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxWidth="300" Margin="5,0">
                            <ItemsControl ItemsSource="{Binding CurrentEvolutionLine}" HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2,0">

                                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0" Visibility="{Binding ShowIncomingArrow, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="{Binding EvoToolTip}">
                                                <Image Source="{Binding EvoItemImagePath, Converter={StaticResource AbsoluteFilePathConverter}}" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,4">
                                                    <Image.Effect>
                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.6"/>
                                                    </Image.Effect>
                                                </Image>
                                                <TextBlock Text="{Binding EvoConditionText}" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="60" TextAlignment="Center" Margin="0,0,0,2"/>
                                                <TextBlock Text="➔" FontSize="18" Foreground="White" Opacity="0.9" HorizontalAlignment="Center" Margin="0,-4,0,0"/>
                                            </StackPanel>

                                            <Button Click="EvolutionNode_Click" Tag="{Binding TargetDex}" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="NodeBorder" Background="Transparent" BorderThickness="2" BorderBrush="Transparent" CornerRadius="12" Padding="4">
                                                            <StackPanel>
                                                                <Image Source="{Binding ImagePath, Converter={StaticResource AbsoluteFilePathConverter}}" 
                                                                       Width="45" Height="45" Stretch="Uniform">
                                                                    <Image.Effect>
                                                                        <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.5"/>
                                                                    </Image.Effect>
                                                                </Image>
                                                                <TextBlock Text="{Binding Species}" FontWeight="Bold" Foreground="White" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter TargetName="NodeBorder" Property="Background" Value="#55FFFFFF"/>
                                                                <Setter TargetName="NodeBorder" Property="BorderBrush" Value="#FFFFFFFF"/>
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Mode=Self}}" Value="True"/>
                                                                    <Condition Binding="{Binding IsCurrent}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter TargetName="NodeBorder" Property="Background" Value="#22FFFFFF"/>
                                                            </MultiDataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Button Grid.Column="2" Content="▶" Click="NextEvoPath_Click" Style="{StaticResource NavButtonStyle}" Width="30" Height="30" FontSize="16"
                                Visibility="{Binding HasMultipleEvolutionPaths, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                </StackPanel>

            </Grid>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource ColorSurface}" Padding="30,20,30,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="{Binding Pokemon.Dex, StringFormat='#{0}'}" FontSize="16" Foreground="{DynamicResource TextColorSecondary}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,2"/>

                    <Grid HorizontalAlignment="Center" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="◀" Click="PrevPoke_Click" Background="Transparent" BorderThickness="0" FontSize="20" Cursor="Hand" VerticalAlignment="Center" Visibility="{Binding HasPreviousPokemon, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource ColorPokedex}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <TextBlock Grid.Column="1" Text="{Binding Pokemon.Name}" FontSize="32" FontWeight="Black" Foreground="{DynamicResource TextColorPrimary}" TextAlignment="Center" TextWrapping="Wrap" Margin="10,0"/>

                        <Button Grid.Column="2" Content="▶" Click="NextPoke_Click" Background="Transparent" BorderThickness="0" FontSize="20" Cursor="Hand" VerticalAlignment="Center" Visibility="{Binding HasNextPokemon, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource ColorPokedex}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Pokemon.Types}" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding Converter={StaticResource TypeToImageConverter}}" Height="24" Margin="5,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Separator Grid.Row="0" VerticalAlignment="Bottom" Margin="0,15,0,0" Background="{DynamicResource ColorBorder}"/>

                <Grid Grid.Row="1" Margin="0,15,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="✨ Shiny" IsChecked="{Binding IsShiny, Mode=TwoWay}" Visibility="{Binding HasShinyVariant, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,20,0" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextColorSecondary}" Cursor="Hand"/>
                        <CheckBox Content="♀ Female" IsChecked="{Binding IsFemale, Mode=TwoWay}" Visibility="{Binding HasFemaleVariant, Converter={StaticResource BooleanToVisibilityConverter}}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextColorSecondary}" Cursor="Hand"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,25,0">
                            <TextBlock Text="HEIGHT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextColorSecondary}" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding Pokemon.Height}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextColorPrimary}" HorizontalAlignment="Right"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="WEIGHT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextColorSecondary}" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding Pokemon.Weight}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextColorPrimary}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                    <TextBlock Text="ABILITIES" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextColorSecondary}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <ItemsControl ItemsSource="{Binding DisplayAbilities}" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource ColorSurfaceVariant}" CornerRadius="8" Padding="14,6" Margin="4,0">
                                    <TextBlock Text="{Binding}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextColorPrimary}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-20,0,0">
                        <TextBlock Text="BASE STATS" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextColorSecondary}" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                        <Canvas Width="200" Height="200" HorizontalAlignment="Center">
                            <Polygon Points="100,35 156.29,67.5 156.29,132.5 100,165 43.71,132.5 43.71,67.5" Fill="Transparent" Stroke="{DynamicResource ColorBorder}" StrokeThickness="2"/>
                            <Polygon Points="100,67.5 128.15,83.75 128.15,116.25 100,132.5 71.85,116.25 71.85,83.75" Fill="Transparent" Stroke="{DynamicResource ColorBorder}" StrokeThickness="1"/>
                            <Line X1="100" Y1="35" X2="100" Y2="165" Stroke="{DynamicResource ColorBorder}" StrokeThickness="1"/>
                            <Line X1="43.71" Y1="67.5" X2="156.29" Y2="132.5" Stroke="{DynamicResource ColorBorder}" StrokeThickness="1"/>
                            <Line X1="43.71" Y1="132.5" X2="156.29" Y2="67.5" Stroke="{DynamicResource ColorBorder}" StrokeThickness="1"/>

                            <Polygon Fill="#884A90E2" Stroke="#4A90E2" StrokeThickness="2">
                                <Polygon.Style>
                                    <Style TargetType="Polygon">
                                        <Setter Property="Points">
                                            <Setter.Value>
                                                <MultiBinding Converter="{StaticResource StatsToPolygonConverter}">
                                                    <Binding Path="Pokemon.Hp"/>
                                                    <Binding Path="Pokemon.Atk"/>
                                                    <Binding Path="Pokemon.Def"/>
                                                    <Binding Path="Pokemon.Spa"/>
                                                    <Binding Path="Pokemon.Spd"/>
                                                    <Binding Path="Pokemon.Spe"/>
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Polygon.Style>
                            </Polygon>

                            <StackPanel Canvas.Left="85" Canvas.Top="2" Width="30">
                                <TextBlock Text="HP" FontSize="11" FontWeight="Bold" Foreground="#FF5959" TextAlignment="Center"/>
                                <TextBlock Text="{Binding Pokemon.Hp}" FontSize="12" FontWeight="Black" Foreground="{DynamicResource TextColorPrimary}" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Canvas.Left="162" Canvas.Top="55" Width="35">
                                <TextBlock Text="ATK" FontSize="11" FontWeight="Bold" Foreground="#F5AC78" TextAlignment="Center"/>
                                <TextBlock Text="{Binding Pokemon.Atk}" FontSize="12" FontWeight="Black" Foreground="{DynamicResource TextColorPrimary}" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Canvas.Left="162" Canvas.Top="120" Width="35">
                                <TextBlock Text="DEF" FontSize="11" FontWeight="Bold" Foreground="#FAE078" TextAlignment="Center"/>
                                <TextBlock Text="{Binding Pokemon.Def}" FontSize="12" FontWeight="Black" Foreground="{DynamicResource TextColorPrimary}" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Canvas.Left="85" Canvas.Top="168" Width="30">
                                <TextBlock Text="SPE" FontSize="11" FontWeight="Bold" Foreground="#FA92B2" TextAlignment="Center"/>
                                <TextBlock Text="{Binding Pokemon.Spe}" FontSize="12" FontWeight="Black" Foreground="{DynamicResource TextColorPrimary}" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Canvas.Left="-5" Canvas.Top="120" Width="42">
                                <TextBlock Text="SP.D" FontSize="11" FontWeight="Bold" Foreground="#A7DB8D" TextAlignment="Center"/>
                                <TextBlock Text="{Binding Pokemon.Spd}" FontSize="12" FontWeight="Black" Foreground="{DynamicResource TextColorPrimary}" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Canvas.Left="-5" Canvas.Top="55" Width="42">
                                <TextBlock Text="SP.A" FontSize="11" FontWeight="Bold" Foreground="#9DB7F5" TextAlignment="Center"/>
                                <TextBlock Text="{Binding Pokemon.Spa}" FontSize="12" FontWeight="Black" Foreground="{DynamicResource TextColorPrimary}" TextAlignment="Center"/>
                            </StackPanel>
                        </Canvas>
                    </StackPanel>

                    <Border Grid.Column="1" Background="{DynamicResource ColorSurfaceVariant}" CornerRadius="12" VerticalAlignment="Center" Padding="25">
                        <StackPanel>
                            <TextBlock Text="TOTAL" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextColorSecondary}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding Pokemon.Bst}" FontSize="40" FontWeight="Black" Foreground="{DynamicResource TextColorPrimary}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Button Grid.Row="4" Content="CLOSE" Click="Close_Click" HorizontalAlignment="Right"
                        Width="130" Height="40" Background="{DynamicResource ColorBorder}" Foreground="{DynamicResource TextColorPrimary}" 
                        Style="{StaticResource MaterialButton}" Margin="0,10,0,0" />

            </Grid>
        </Border>
    </Grid>
</Window>