<Window x:Class="Pokedex.views.PokemonDetailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalhes do Pokémon" Height="720" Width="450"
        WindowStartupLocation="CenterScreen" Background="#F5F5F7">

    <Window.Resources>
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.5"/>
                                </ContentPresenter.Effect>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#DDD"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Height="260" VerticalAlignment="Top" CornerRadius="0 0 40 40"
                Background="{Binding Types, Converter={StaticResource TypeToBrushConverter}}">
            <Grid>
                <DockPanel LastChildFill="True" Margin="20,40,20,0">

                    <Button Content="‹" DockPanel.Dock="Left" VerticalAlignment="Center"
        Style="{StaticResource NavigationButtonStyle}"
        Click="FormaAnterior_Click"
        Visibility="{Binding HasMultipleForms, Converter={StaticResource StringToVisibilityConverter}}"/>

                    <Button Content="›" DockPanel.Dock="Right" VerticalAlignment="Center"
        Style="{StaticResource NavigationButtonStyle}"
        Click="ProximaForma_Click"
        Visibility="{Binding HasMultipleForms, Converter={StaticResource StringToVisibilityConverter}}"/>

                    <Image x:Name="PokemonDisplay" Height="200" Stretch="Uniform">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Source" Value="{Binding Image}"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsChecked, ElementName=chkShiny}" Value="True"/>
                                            <Condition Binding="{Binding IsChecked, ElementName=chkFemale}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Source" Value="{Binding Shiny}"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsChecked, ElementName=chkShiny}" Value="False"/>
                                            <Condition Binding="{Binding IsChecked, ElementName=chkFemale}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Source" Value="{Binding Female}"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsChecked, ElementName=chkShiny}" Value="True"/>
                                            <Condition Binding="{Binding IsChecked, ElementName=chkFemale}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Source" Value="{Binding Female_shiny}"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                </DockPanel>
            </Grid>
        </Border>

        <StackPanel Margin="30,270,30,20">
            <TextBlock Text="{Binding Dex, StringFormat='Nº {0}'}" 
                       FontSize="16" FontWeight="Bold" Foreground="Gray" HorizontalAlignment="Center"/>

            <TextBlock Text="{Binding Name}" FontSize="32" FontWeight="Bold" 
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <ItemsControl ItemsSource="{Binding Types}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Image Source="{Binding Converter={StaticResource TypeImageConverter}}" 
                               Height="28" Margin="5,0"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <UniformGrid Columns="2" Margin="0,20">
                <CheckBox x:Name="chkShiny" Content="Shiny ✨" HorizontalAlignment="Center" VerticalContentAlignment="Center"/>
                <CheckBox x:Name="chkFemale" Content="Fêmea ♀" HorizontalAlignment="Center" VerticalContentAlignment="Center"
                          Visibility="{Binding Female, Converter={StaticResource StringToVisibilityConverter}}"/>
            </UniformGrid>

            <Separator Background="#DDD" Margin="0,10"/>

            <TextBlock Text="Base Stats" FontSize="18" FontWeight="Bold" Margin="0,10" Foreground="#444"/>
            <UniformGrid Columns="3" Rows="2">
                <StackPanel Margin="10,5">
                    <TextBlock Text="HP" FontSize="11" FontWeight="Bold" Foreground="Gray"/>
                    <TextBlock Text="{Binding HP}" FontSize="22" FontWeight="SemiBold" Foreground="#FF5959"/>
                </StackPanel>
                <StackPanel Margin="10,5">
                    <TextBlock Text="ATK" FontSize="11" FontWeight="Bold" Foreground="Gray"/>
                    <TextBlock Text="{Binding ATK}" FontSize="22" FontWeight="SemiBold" Foreground="#F5AC78"/>
                </StackPanel>
                <StackPanel Margin="10,5">
                    <TextBlock Text="DEF" FontSize="11" FontWeight="Bold" Foreground="Gray"/>
                    <TextBlock Text="{Binding DEF}" FontSize="22" FontWeight="SemiBold" Foreground="#FAE078"/>
                </StackPanel>
                <StackPanel Margin="10,5">
                    <TextBlock Text="SP. ATK" FontSize="11" FontWeight="Bold" Foreground="Gray"/>
                    <TextBlock Text="{Binding SPATK}" FontSize="22" FontWeight="SemiBold" Foreground="#9DB7F5"/>
                </StackPanel>
                <StackPanel Margin="10,5">
                    <TextBlock Text="SP. DEF" FontSize="11" FontWeight="Bold" Foreground="Gray"/>
                    <TextBlock Text="{Binding SPDEF}" FontSize="22" FontWeight="SemiBold" Foreground="#A7DB8D"/>
                </StackPanel>
                <StackPanel Margin="10,5">
                    <TextBlock Text="SPEED" FontSize="11" FontWeight="Bold" Foreground="Gray"/>
                    <TextBlock Text="{Binding SPE}" FontSize="22" FontWeight="SemiBold" Foreground="#FA92B2"/>
                </StackPanel>
            </UniformGrid>

            <Button Content="VOLTAR" Click="Close_Click" Margin="0,30,0,0" 
                    Width="140" Height="45" Background="#333" Foreground="White" FontWeight="Bold">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="22"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>