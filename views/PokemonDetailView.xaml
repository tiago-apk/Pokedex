<Window x:Class="Pokedex.views.PokemonDetailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Pokedex.services"
        Title="{Binding Pokemon.Name, FallbackValue='Pokemon Data'}" 
        Height="720" Width="1280" 
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" 
        Background="{DynamicResource AppBackground}"
        WindowStyle="None">

    <Window.Resources>
        <services:TypeToBrushConverter x:Key="TypeToBrushConverter" />
        <services:TypeToImageConverter x:Key="TypeToImageConverter" />
        <services:AbsoluteFilePathConverter x:Key="AbsoluteFilePathConverter" />
        <services:StatsToPolygonConverter x:Key="StatsToPolygonConverter" />
        <services:IntToVisConverter x:Key="IntToVisConverter" />
        <services:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="TabItemStyle" TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" BorderThickness="0,0,0,3" BorderBrush="Transparent" Margin="0,0,20,0" Padding="5,8">
                            <ContentPresenter x:Name="ContentSite" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource TextColorPrimary}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextColorPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#44000000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EvoArrowStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="450"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{Binding Pokemon.Types, Converter={StaticResource TypeToBrushConverter}}">
            <Grid Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Button Content="‹" HorizontalAlignment="Left" Command="{Binding PrevFormCommand}" Style="{StaticResource NavButtonStyle}" Visibility="{Binding HasMultipleForms, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Image Source="{Binding DisplayedImage, Converter={StaticResource AbsoluteFilePathConverter}}" Stretch="Uniform" MaxHeight="300">
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="30" ShadowDepth="15" Opacity="0.5"/>
                        </Image.Effect>
                    </Image>
                    <Button Content="›" HorizontalAlignment="Right" Command="{Binding NextFormCommand}" Style="{StaticResource NavButtonStyle}" Visibility="{Binding HasMultipleForms, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,15,0,25">
                    <TextBlock Text="{Binding CurrentFormName}" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,10" Visibility="{Binding CurrentFormName, Converter={StaticResource StringToVisibilityConverter}}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Button Content="◀" Command="{Binding PrevDescriptionCommand}" Style="{StaticResource NavButtonStyle}" Width="35" Height="35" FontSize="14"/>
                        <Border CornerRadius="8" Padding="15,5" Margin="15,0" Background="#66000000">
                            <TextBlock Text="{Binding CurrentEntry.Game}" Foreground="White" FontWeight="Black" FontSize="12"/>
                        </Border>
                        <Button Content="▶" Command="{Binding NextDescriptionCommand}" Style="{StaticResource NavButtonStyle}" Width="35" Height="35" FontSize="14"/>
                    </StackPanel>
                    <TextBlock Text="{Binding CurrentEntry.Description}" Foreground="White" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" MinHeight="80" Opacity="0.95"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="EVOLUTION PATH" FontSize="12" FontWeight="Bold" Foreground="White" Opacity="0.7" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <Grid HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="◀" Command="{Binding PrevEvoPathCommand}" Style="{StaticResource EvoArrowStyle}" Visibility="{Binding HasMultipleEvolutionPaths, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <ItemsControl Grid.Column="1" ItemsSource="{Binding CurrentEvolutionLine}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel VerticalAlignment="Center" Visibility="{Binding ShowIncomingArrow, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="5,0">
                                            <Image Source="{Binding EvoItemImagePath, Converter={StaticResource AbsoluteFilePathConverter}}" Width="25" Height="25"/>
                                            <TextBlock Text="➔" Foreground="White" HorizontalAlignment="Center" FontSize="14"/>
                                        </StackPanel>
                                        <Button Command="{Binding DataContext.NavigateToPokemonCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding TargetId}" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                            <StackPanel Margin="6">
                                                <Image Source="{Binding ImagePath, Converter={StaticResource AbsoluteFilePathConverter}}" Width="50" Height="50">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Opacity" Value="0.4"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Opacity" Value="1.0"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <TextBlock Text="{Binding Species}" Foreground="White" FontSize="11" HorizontalAlignment="Center" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Grid.Column="2" Content="▶" Command="{Binding NextEvoPathCommand}" Style="{StaticResource EvoArrowStyle}" Visibility="{Binding HasMultipleEvolutionPaths, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource ColorSurface}" Padding="40,30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="{Binding Pokemon.NationalDex, StringFormat='#{0:D4}'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextColorSecondary}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="◀" Command="{Binding PrevPokemonCommand}" Background="Transparent" BorderThickness="0" FontSize="35" Foreground="{DynamicResource TextColorSecondary}" Cursor="Hand"/>
                        <TextBlock Grid.Column="1" Text="{Binding Pokemon.Name}" FontSize="46" FontWeight="Black" Foreground="{DynamicResource TextColorPrimary}" HorizontalAlignment="Center"/>
                        <Button Grid.Column="2" Content="▶" Command="{Binding NextPokemonCommand}" Background="Transparent" BorderThickness="0" FontSize="35" Foreground="{DynamicResource TextColorSecondary}" Cursor="Hand"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Pokemon.Types}" HorizontalAlignment="Left" Margin="0,5">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding TypeName, Converter={StaticResource TypeToImageConverter}}" Height="28" Margin="0,0,10,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,15,0,15">
                    <CheckBox Content="✨ Shiny" IsChecked="{Binding IsShiny}" Margin="0,0,30,0" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextColorSecondary}"/>
                    <CheckBox Content="♀ Female" IsChecked="{Binding IsFemale}" Visibility="{Binding HasFemaleVariant, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextColorSecondary}"/>
                </StackPanel>

                <Border Grid.Row="2" Background="#08000000" CornerRadius="10" Padding="15,10" Margin="0,0,0,15" Visibility="{Binding Pokemon.LocalDexes.Count, Converter={StaticResource IntToVisConverter}}">
                    <StackPanel>
                        <TextBlock Text="REGIONAL POKÉDEX" FontSize="10" FontWeight="Black" Foreground="{DynamicResource TextColorSecondary}" Margin="0,0,0,8" Opacity="0.6"/>

                        <ItemsControl ItemsSource="{Binding Pokemon.LocalDexes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,5,2">
                                        <TextBlock Text="{Binding Region}" Foreground="{DynamicResource TextColorPrimary}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" MaxWidth="90" TextTrimming="CharacterEllipsis" ToolTip="{Binding Region}"/>
                                        <TextBlock Text=" - " Foreground="Gray" FontSize="10" VerticalAlignment="Center" Margin="2,0"/>
                                        <TextBlock Text="{Binding Generation}" Foreground="Gray" FontSize="10" VerticalAlignment="Center"/>
                                        <TextBlock Text=" - " Foreground="Gray" FontSize="10" VerticalAlignment="Center" Margin="2,0"/>
                                        <TextBlock Text="{Binding DexNumber, StringFormat='#{0}'}" Foreground="{DynamicResource TextColorPrimary}" FontWeight="Black" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TabControl Grid.Row="3" Background="Transparent" BorderThickness="0">

                    <TabItem Header="BASE STATS" Style="{StaticResource TabItemStyle}">
                        <Grid Margin="0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Canvas Grid.Column="0" Width="200" Height="200" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Polygon Points="100,20 180,60 180,140 100,180 20,140 20,60" 
         Stroke="{DynamicResource TextColorPrimary}" 
         Fill="{DynamicResource TextColorPrimary}" 
         Opacity="0.15" 
         StrokeThickness="1"/>
                                <Polygon Fill="#AA4A90E2" Stroke="#4A90E2" StrokeThickness="2">
                                    <Polygon.Style>
                                        <Style TargetType="Polygon">
                                            <Setter Property="Points">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource StatsToPolygonConverter}">
                                                        <Binding Path="Pokemon.Hp"/>
                                                        <Binding Path="Pokemon.Attack"/>
                                                        <Binding Path="Pokemon.Defense"/>
                                                        <Binding Path="Pokemon.SpAtk"/>
                                                        <Binding Path="Pokemon.SpDef"/>
                                                        <Binding Path="Pokemon.Speed"/>
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Polygon.Style>
                                </Polygon>
                            </Canvas>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Pokemon.Hp, StringFormat='HP: {0}'}" FontSize="15" FontWeight="Bold" Margin="0,6"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Pokemon.Attack, StringFormat='Atk: {0}'}" FontSize="15" FontWeight="Bold" Margin="0,6"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Pokemon.Defense, StringFormat='Def: {0}'}" FontSize="15" FontWeight="Bold" Margin="0,6"/>

                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Pokemon.SpAtk, StringFormat='Sp.Atk: {0}'}" FontSize="15" FontWeight="Bold" Margin="0,6"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Pokemon.SpDef, StringFormat='Sp.Def: {0}'}" FontSize="15" FontWeight="Bold" Margin="0,6"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Pokemon.Speed, StringFormat='Spe: {0}'}" FontSize="15" FontWeight="Bold" Margin="0,6"/>
                                </Grid>

                                <TextBlock Text="{Binding Pokemon.TotalStats, StringFormat='Total: {0}'}" FontWeight="Black" FontSize="20" Foreground="{DynamicResource TextColorPrimary}"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="BIOLOGY" Style="{StaticResource TabItemStyle}">
                        <Grid Margin="0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Height" Foreground="Gray" FontSize="13"/>
                                <TextBlock Text="{Binding Pokemon.Height}" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                                <TextBlock Text="Weight" Foreground="Gray" FontSize="13"/>
                                <TextBlock Text="{Binding Pokemon.Weight}" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                                <TextBlock Text="Egg Cycles" Foreground="Gray" FontSize="13"/>
                                <TextBlock Text="{Binding Pokemon.EggCycles}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,15"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Abilities" Foreground="Gray" FontSize="13"/>
                                <ItemsControl ItemsSource="{Binding DisplayAbilities}" Margin="0,0,0,15">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="14" FontWeight="SemiBold" Margin="0,1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Egg Groups" Foreground="Gray" FontSize="13"/>
                                <ItemsControl ItemsSource="{Binding Pokemon.EggGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding EggGroupName}" FontSize="14" FontWeight="SemiBold" Margin="0,1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="TRAINING" Style="{StaticResource TabItemStyle}">
                        <Grid Margin="0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Catch Rate" Foreground="Gray" FontSize="13"/>
                                <TextBlock Text="{Binding Pokemon.CatchRate}" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>

                                <TextBlock Text="Base Friendship" Foreground="Gray" FontSize="13"/>
                                <TextBlock Text="{Binding Pokemon.BaseFriendship}" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>

                                <TextBlock Text="Base Exp" Foreground="Gray" FontSize="13"/>
                                <TextBlock Text="{Binding Pokemon.BaseExp}" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Growth Rate" Foreground="Gray" FontSize="13"/>
                                <TextBlock Text="{Binding Pokemon.GrowthRate}" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>

                                <TextBlock Text="EV Yields" Foreground="Gray" FontSize="13"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Pokemon.EvHp, StringFormat='HP: {0}'}" FontSize="14" FontWeight="SemiBold" Visibility="{Binding Pokemon.EvHp, Converter={StaticResource IntToVisConverter}}"/>
                                    <TextBlock Text="{Binding Pokemon.EvAttack, StringFormat='Atk: {0}'}" FontSize="14" FontWeight="SemiBold" Visibility="{Binding Pokemon.EvAttack, Converter={StaticResource IntToVisConverter}}"/>
                                    <TextBlock Text="{Binding Pokemon.EvDefense, StringFormat='Def: {0}'}" FontSize="14" FontWeight="SemiBold" Visibility="{Binding Pokemon.EvDefense, Converter={StaticResource IntToVisConverter}}"/>
                                    <TextBlock Text="{Binding Pokemon.EvSpAtk, StringFormat='Sp.Atk: {0}'}" FontSize="14" FontWeight="SemiBold" Visibility="{Binding Pokemon.EvSpAtk, Converter={StaticResource IntToVisConverter}}"/>
                                    <TextBlock Text="{Binding Pokemon.EvSpDef, StringFormat='Sp.Def: {0}'}" FontSize="14" FontWeight="SemiBold" Visibility="{Binding Pokemon.EvSpDef, Converter={StaticResource IntToVisConverter}}"/>
                                    <TextBlock Text="{Binding Pokemon.EvSpeed, StringFormat='Spe: {0}'}" FontSize="14" FontWeight="SemiBold" Visibility="{Binding Pokemon.EvSpeed, Converter={StaticResource IntToVisConverter}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                </TabControl>

                <Button Grid.Row="4" Content="CLOSE" Click="Close_Click" HorizontalAlignment="Right" Width="120" Height="40" FontSize="14" FontWeight="Bold" Background="{DynamicResource ColorBorder}" Foreground="{DynamicResource TextColorPrimary}" Style="{StaticResource MaterialButton}" Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>