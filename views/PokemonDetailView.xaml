<Window x:Class="Pokedex.views.PokemonDetailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Detalhes do Pokémon" Height="720" Width="450"
        WindowStartupLocation="CenterScreen" Background="#F5F5F7">

    <Grid>
        <Border Height="300" VerticalAlignment="Top" Background="#DEF3FD" CornerRadius="0,0,50,50"/>

        <StackPanel Margin="20">
            <DockPanel>
                <TextBlock Text="{Binding Pokemon.Name}" FontSize="32" FontWeight="Bold" Foreground="#333"/>
                <TextBlock Text="{Binding Pokemon.Dex, StringFormat='#{0}'}" FontSize="20" 
                           Foreground="Gray" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>

            <ItemsControl ItemsSource="{Binding DisplayTypes}" Margin="0,10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#A7DB8D" CornerRadius="10" Padding="12,4" Margin="0,0,8,0">
                            <TextBlock Text="{Binding}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Height="280" Margin="0,20">
                <Image Source="{Binding DisplayedImage}" Stretch="Uniform" Margin="20"/>

                <Button Content="‹" HorizontalAlignment="Left" 
            Click="PreviousForm_Click" 
            Style="{StaticResource NavigationButtonStyle}"/>

                <Button Content="›" HorizontalAlignment="Right" 
            Click="NextForm_Click" 
            Style="{StaticResource NavigationButtonStyle}"/>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                <CheckBox Content="Shiny" IsChecked="{Binding IsShiny}" Margin="10,0"/>
                <CheckBox Content="Female" IsChecked="{Binding IsFemale}" 
                          Visibility="{Binding HasFemaleVariant, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="10,0"/>
            </StackPanel>

            <UniformGrid Columns="3" Margin="0,20">
                <StackPanel Margin="10,5">
                    <TextBlock Text="HP" FontSize="11" FontWeight="Bold" Foreground="Gray"/>
                    <TextBlock Text="{Binding Pokemon.Hp}" FontSize="22" FontWeight="SemiBold" Foreground="#FF5959"/>
                </StackPanel>
                <StackPanel Margin="10,5">
                    <TextBlock Text="ATTACK" FontSize="11" FontWeight="Bold" Foreground="Gray"/>
                    <TextBlock Text="{Binding Pokemon.Atk}" FontSize="22" FontWeight="SemiBold" Foreground="#F5AC78"/>
                </StackPanel>
                <StackPanel Margin="10,5">
                    <TextBlock Text="DEFENSE" FontSize="11" FontWeight="Bold" Foreground="Gray"/>
                    <TextBlock Text="{Binding Pokemon.Def}" FontSize="22" FontWeight="SemiBold" Foreground="#FAE078"/>
                </StackPanel>
                <StackPanel Margin="10,5">
                    <TextBlock Text="SP. ATK" FontSize="11" FontWeight="Bold" Foreground="Gray"/>
                    <TextBlock Text="{Binding Pokemon.Spa}" FontSize="22" FontWeight="SemiBold" Foreground="#9DB7F5"/>
                </StackPanel>
                <StackPanel Margin="10,5">
                    <TextBlock Text="SP. DEF" FontSize="11" FontWeight="Bold" Foreground="Gray"/>
                    <TextBlock Text="{Binding Pokemon.Spd}" FontSize="22" FontWeight="SemiBold" Foreground="#A7DB8D"/>
                </StackPanel>
                <StackPanel Margin="10,5">
                    <TextBlock Text="SPEED" FontSize="11" FontWeight="Bold" Foreground="Gray"/>
                    <TextBlock Text="{Binding Pokemon.Spe}" FontSize="22" FontWeight="SemiBold" Foreground="#FA92B2"/>
                </StackPanel>
            </UniformGrid>

            <Button Content="CLOSE" Click="Close_Click" Margin="0,20,0,0" 
        Width="140" Height="40" Background="#333" Foreground="White" 
        FontWeight="Bold">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="20"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>