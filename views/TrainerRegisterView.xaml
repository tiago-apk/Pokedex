<UserControl x:Class="Pokedex.views.TrainerRegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:services="clr-namespace:Pokedex.services"
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="1100"
             Background="Transparent">

    <UserControl.Resources>
        <services:IntToBoolConverter x:Key="IntToBoolConverter" />
    </UserControl.Resources>

    <Grid>
        <Border Background="{DynamicResource ColorSurface}" CornerRadius="16" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,35">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.08"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="T R A I N E R   C A R D" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextColorPrimary}" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <TextBlock Text="NAME" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextColorSecondary}" Margin="0,0,0,2"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource ColorTrainerAccent}" Margin="0,0,0,15"/>

                <TextBlock Text="TRAINER ID" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextColorSecondary}" Margin="0,0,0,2"/>
                <TextBox Text="{Binding TrainerId, UpdateSourceTrigger=PropertyChanged}" 
                         MaxLength="6" 
                         PreviewTextInput="NumberValidationTextBox"
                         Tag="{DynamicResource ColorTrainerAccent}" Margin="0,0,0,15"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="REGION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextColorSecondary}" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding Regions}" SelectedItem="{Binding SelectedRegion}" 
                                  Style="{StaticResource MaterialComboBox}" Tag="{DynamicResource ColorTrainerAccent}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="GENERATION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextColorSecondary}" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding Generations}" SelectedItem="{Binding SelectedGeneration}" 
                                  IsEnabled="{Binding Generations.Count, Converter={StaticResource IntToBoolConverter}}" 
                                  Style="{StaticResource MaterialComboBox}" Tag="{DynamicResource ColorTrainerAccent}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="GAME" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextColorSecondary}" Margin="0,0,0,2"/>
                <ComboBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" 
                          IsEnabled="{Binding Games.Count, Converter={StaticResource IntToBoolConverter}}" 
                          Style="{StaticResource MaterialComboBox}" Tag="{DynamicResource ColorTrainerAccent}" Margin="0,0,0,35"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="CANCEL" Click="btnCancel_Click" 
                            Style="{StaticResource MaterialButton}" Background="{DynamicResource ColorBorder}" Foreground="{DynamicResource TextColorPrimary}"/>

                    <Button Grid.Column="2" Content="SAVE" Click="btnSave_Click" 
                            Style="{StaticResource MaterialButton}" Background="{DynamicResource ColorTrainer}"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>