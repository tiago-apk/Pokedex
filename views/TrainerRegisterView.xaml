<UserControl x:Class="Pokedex.views.TrainerRegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F7">

    <Grid Margin="40">
        <Border Background="White" CornerRadius="20" MaxWidth="550" VerticalAlignment="Top" Padding="30">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.1"/>
            </Border.Effect>

            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                    <Ellipse Width="15" Height="15" Fill="#FFC107" Margin="0,0,10,0"/>
                    <TextBlock Text="Novo Cadastro de Treinador" FontSize="22" FontWeight="Bold" Foreground="#212121"/>
                </StackPanel>

                <TextBlock Text="Nome Completo" FontSize="12" FontWeight="Bold" Foreground="#FFC107" Margin="5,0,0,5"/>
                <Border Background="#F0F2F5" CornerRadius="10" Padding="15,5" Margin="0,0,0,20">
                    <TextBox BorderThickness="0" Background="Transparent" FontSize="16" 
                             VerticalContentAlignment="Center" 
                             Text="{Binding NewTrainer.Name, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Ex: Ash Ketchum, Red..."/>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Idade" FontSize="12" FontWeight="Bold" Foreground="#FFC107" Margin="5,0,0,5"/>
                        <Border Background="#F0F2F5" CornerRadius="10" Padding="15,5">
                            <TextBox BorderThickness="0" Background="Transparent" FontSize="16" 
                                     Text="{Binding NewTrainer.Age}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Região de Origem" FontSize="12" FontWeight="Bold" Foreground="#FFC107" Margin="5,0,0,5"/>
                        <Border Background="#F0F2F5" CornerRadius="10" Padding="10,2">
                            <ComboBox BorderThickness="0" Background="Transparent" Height="35"
                                      ItemsSource="{Binding RegionsList}"
                                      SelectedItem="{Binding SelectedRegion}"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Breve Descrição / Bio" FontSize="12" FontWeight="Bold" Foreground="#FFC107" Margin="5,20,0,5"/>
                <Border Background="#F0F2F5" CornerRadius="10" Padding="15,5">
                    <TextBox BorderThickness="0" Background="Transparent" FontSize="14" 
                             AcceptsReturn="True" Height="80" VerticalScrollBarVisibility="Auto"
                             Text="{Binding NewTrainer.Bio}"/>
                </Border>

                <Button Content="CADASTRAR TREINADOR" 
                        Style="{StaticResource TrainerButtonStyle}" 
                        Margin="0,40,0,0" Height="55"
                        Command="{Binding SaveTrainerCommand}"/>

                <TextBlock Text="{Binding StatusMessage}" Foreground="Gray" Margin="0,15,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>