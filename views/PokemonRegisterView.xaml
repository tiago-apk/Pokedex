<UserControl x:Class="Pokedex.views.PokemonRegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="Transparent">

    <Grid>
        <Border Background="{DynamicResource ColorSurface}" CornerRadius="16" Width="880" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30,25">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.08"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="P O K É M O N   B U I L D E R" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextColorPrimary}" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <TextBlock Text="TRAINER" FontSize="11" FontWeight="Bold" Foreground="#888" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding Trainers}" SelectedItem="{Binding SelectedTrainer}" DisplayMemberPath="Name" 
                                  Margin="0,0,0,12" Style="{StaticResource MaterialComboBox}" Tag="{DynamicResource ColorPokemonAccent}"/>

                        <TextBlock Text="POKÉMON (BASE)" FontSize="11" FontWeight="Bold" Foreground="#888" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding FilteredSpecies}" SelectedItem="{Binding SelectedBasePokemon}" DisplayMemberPath="Name" 
                                  Margin="0,0,0,12" Style="{StaticResource MaterialComboBox}" Tag="{DynamicResource ColorPokemonAccent}"/>

                        <TextBlock Text="FORM / VARIANT" FontSize="11" FontWeight="Bold" Foreground="#888" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding AvailableForms}" SelectedItem="{Binding SelectedForm}" DisplayMemberPath="Name" 
                                  Margin="0,0,0,12" Style="{StaticResource MaterialComboBox}" Tag="{DynamicResource ColorPokemonAccent}"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="35"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="NICKNAME" FontSize="11" FontWeight="Bold" Foreground="#888" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding Nickname, UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource ColorPokemonAccent}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                <ToggleButton IsChecked="{Binding IsShiny, Mode=TwoWay}" Width="35" Height="35" Cursor="Hand" Background="Transparent" BorderThickness="0" ToolTip="Make Shiny!">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Content" Value="⭐"/>
                                            <Setter Property="FontSize" Value="20"/>
                                            <Setter Property="Foreground" Value="#E0E0E0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Foreground" Value="#FFD700"/>
                                                    <Setter Property="Content" Value="🌟"/>
                                                    <Setter Property="FontSize" Value="24"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="ABILITY" FontSize="11" FontWeight="Bold" Foreground="#888" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding AvailableAbilities}" SelectedItem="{Binding Ability}" IsEditable="True" 
                                  Margin="0,0,0,12" Style="{StaticResource MaterialComboBox}" Tag="{DynamicResource ColorPokemonAccent}"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="NATURE" FontSize="11" FontWeight="Bold" Foreground="#888" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding Natures}" SelectedItem="{Binding SelectedNature}" DisplayMemberPath="Name" 
                                          Style="{StaticResource MaterialComboBox}" Tag="{DynamicResource ColorPokemonAccent}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="LEVEL" FontSize="11" FontWeight="Bold" Foreground="#888" Margin="0,0,0,2"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Value="{Binding Level, Mode=TwoWay}" Grid.Column="0" Minimum="1" Maximum="100" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,8,0"
                                            Style="{StaticResource MaterialSlider}" Tag="{DynamicResource ColorPokemonAccent}"/>

                                    <TextBox Grid.Column="1" Text="{Binding Level, UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource ColorPokemonAccent}" TextAlignment="Center" MaxLength="3"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="GENETICS &amp; TRAINING" FontSize="12" FontWeight="ExtraBold" Foreground="{DynamicResource TextColorPrimary}" Margin="0,0,0,8" HorizontalAlignment="Center"/>

                        <Border Background="{DynamicResource ColorSurface}" CornerRadius="10" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="35"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="STAT" FontSize="10" FontWeight="Bold" Foreground="#888" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="IV (0-31)" FontSize="9" FontWeight="Bold" Foreground="#888" HorizontalAlignment="Right" Margin="0,0,5,6"/>
                                <TextBlock Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="2" Text="EV (0-255)" FontSize="9" FontWeight="Bold" Foreground="#888" HorizontalAlignment="Right" Margin="0,0,5,6"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="HP" FontSize="12" FontWeight="Black" Foreground="#FF5959" VerticalAlignment="Center" Margin="0,3"/>
                                <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="31" Value="{Binding IvHp, Mode=TwoWay}" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,5,0" Style="{StaticResource MaterialSlider}" Tag="{DynamicResource ColorPokemonAccent}"/>
                                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding IvHp, UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource ColorPokemonAccent}" TextAlignment="Center" MaxLength="2" Margin="0,2" Padding="2"/>
                                <Slider Grid.Row="1" Grid.Column="4" Minimum="0" Maximum="{Binding MaxEvHp}" Value="{Binding EvHp, Mode=TwoWay}" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,5,0" Style="{StaticResource MaterialSlider}" Tag="{DynamicResource ColorPokemonAccent}"/>
                                <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding EvHp, UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource ColorPokemonAccent}" TextAlignment="Center" MaxLength="3" Margin="0,2" Padding="2"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Attack" FontSize="12" FontWeight="Black" Foreground="#F5AC78" VerticalAlignment="Center" Margin="0,3"/>
                                <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="31" Value="{Binding IvAtk, Mode=TwoWay}" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,5,0" Style="{StaticResource MaterialSlider}" Tag="{DynamicResource ColorPokemonAccent}"/>
                                <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding IvAtk, UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource ColorPokemonAccent}" TextAlignment="Center" MaxLength="2" Margin="0,2" Padding="2"/>
                                <Slider Grid.Row="2" Grid.Column="4" Minimum="0" Maximum="{Binding MaxEvAtk}" Value="{Binding EvAtk, Mode=TwoWay}" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,5,0" Style="{StaticResource MaterialSlider}" Tag="{DynamicResource ColorPokemonAccent}"/>
                                <TextBox Grid.Row="2" Grid.Column="5" Text="{Binding EvAtk, UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource ColorPokemonAccent}" TextAlignment="Center" MaxLength="3" Margin="0,2" Padding="2"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Defense" FontSize="12" FontWeight="Black" Foreground="#FAE078" VerticalAlignment="Center" Margin="0,3"/>
                                <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="31" Value="{Binding IvDef, Mode=TwoWay}" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,5,0" Style="{StaticResource MaterialSlider}" Tag="{DynamicResource ColorPokemonAccent}"/>
                                <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding IvDef, UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource ColorPokemonAccent}" TextAlignment="Center" MaxLength="2" Margin="0,2" Padding="2"/>
                                <Slider Grid.Row="3" Grid.Column="4" Minimum="0" Maximum="{Binding MaxEvDef}" Value="{Binding EvDef, Mode=TwoWay}" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,5,0" Style="{StaticResource MaterialSlider}" Tag="{DynamicResource ColorPokemonAccent}"/>
                                <TextBox Grid.Row="3" Grid.Column="5" Text="{Binding EvDef, UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource ColorPokemonAccent}" TextAlignment="Center" MaxLength="3" Margin="0,2" Padding="2"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Sp. Atk" FontSize="12" FontWeight="Black" Foreground="#9DB7F5" VerticalAlignment="Center" Margin="0,3"/>
                                <Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="31" Value="{Binding IvSpa, Mode=TwoWay}" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,5,0" Style="{StaticResource MaterialSlider}" Tag="{DynamicResource ColorPokemonAccent}"/>
                                <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding IvSpa, UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource ColorPokemonAccent}" TextAlignment="Center" MaxLength="2" Margin="0,2" Padding="2"/>
                                <Slider Grid.Row="4" Grid.Column="4" Minimum="0" Maximum="{Binding MaxEvSpa}" Value="{Binding EvSpa, Mode=TwoWay}" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,5,0" Style="{StaticResource MaterialSlider}" Tag="{DynamicResource ColorPokemonAccent}"/>
                                <TextBox Grid.Row="4" Grid.Column="5" Text="{Binding EvSpa, UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource ColorPokemonAccent}" TextAlignment="Center" MaxLength="3" Margin="0,2" Padding="2"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Sp. Def" FontSize="12" FontWeight="Black" Foreground="#A7DB8D" VerticalAlignment="Center" Margin="0,3"/>
                                <Slider Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="31" Value="{Binding IvSpd, Mode=TwoWay}" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,5,0" Style="{StaticResource MaterialSlider}" Tag="{DynamicResource ColorPokemonAccent}"/>
                                <TextBox Grid.Row="5" Grid.Column="2" Text="{Binding IvSpd, UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource ColorPokemonAccent}" TextAlignment="Center" MaxLength="2" Margin="0,2" Padding="2"/>
                                <Slider Grid.Row="5" Grid.Column="4" Minimum="0" Maximum="{Binding MaxEvSpd}" Value="{Binding EvSpd, Mode=TwoWay}" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,5,0" Style="{StaticResource MaterialSlider}" Tag="{DynamicResource ColorPokemonAccent}"/>
                                <TextBox Grid.Row="5" Grid.Column="5" Text="{Binding EvSpd, UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource ColorPokemonAccent}" TextAlignment="Center" MaxLength="3" Margin="0,2" Padding="2"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Speed" FontSize="12" FontWeight="Black" Foreground="#FA92B2" VerticalAlignment="Center" Margin="0,3"/>
                                <Slider Grid.Row="6" Grid.Column="1" Minimum="0" Maximum="31" Value="{Binding IvSpe, Mode=TwoWay}" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,5,0" Style="{StaticResource MaterialSlider}" Tag="{DynamicResource ColorPokemonAccent}"/>
                                <TextBox Grid.Row="6" Grid.Column="2" Text="{Binding IvSpe, UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource ColorPokemonAccent}" TextAlignment="Center" MaxLength="2" Margin="0,2" Padding="2"/>
                                <Slider Grid.Row="6" Grid.Column="4" Minimum="0" Maximum="{Binding MaxEvSpe}" Value="{Binding EvSpe, Mode=TwoWay}" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,5,0" Style="{StaticResource MaterialSlider}" Tag="{DynamicResource ColorPokemonAccent}"/>
                                <TextBox Grid.Row="6" Grid.Column="5" Text="{Binding EvSpe, UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource ColorPokemonAccent}" TextAlignment="Center" MaxLength="3" Margin="0,2" Padding="2"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="MOVESET" FontSize="12" FontWeight="ExtraBold" Foreground="#555" Margin="0,15,0,8" HorizontalAlignment="Center"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                <TextBlock Text="MOVE 1" FontSize="9" FontWeight="Bold" Foreground="#AAA" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding AvailableMoves1}" SelectedItem="{Binding Move1}" IsEditable="True" 
                                          Style="{StaticResource MaterialComboBox}" Tag="{DynamicResource ColorPokemonAccent}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                                <TextBlock Text="MOVE 2" FontSize="9" FontWeight="Bold" Foreground="#AAA" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding AvailableMoves2}" SelectedItem="{Binding Move2}" IsEditable="True" 
                                          Style="{StaticResource MaterialComboBox}" Tag="{DynamicResource ColorPokemonAccent}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="MOVE 3" FontSize="9" FontWeight="Bold" Foreground="#AAA" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding AvailableMoves3}" SelectedItem="{Binding Move3}" IsEditable="True" 
                                          Style="{StaticResource MaterialComboBox}" Tag="{DynamicResource ColorPokemonAccent}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="MOVE 4" FontSize="9" FontWeight="Bold" Foreground="#AAA" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding AvailableMoves4}" SelectedItem="{Binding Move4}" IsEditable="True" 
                                          Style="{StaticResource MaterialComboBox}" Tag="{DynamicResource ColorPokemonAccent}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="CANCEL" Click="btnCancel_Click" Foreground="{DynamicResource TextColorPrimary}"
                            Style="{StaticResource MaterialButton}" Background="{DynamicResource ColorBorder}" Height="40"/>

                    <Button Grid.Column="2" Content="SAVE POKÉMON" Click="btnSave_Click" 
                            Style="{StaticResource MaterialButton}" Background="{DynamicResource ColorPokemon}" Height="40"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>