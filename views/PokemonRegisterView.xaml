<UserControl x:Class="Pokedex.views.PokemonRegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F7">

    <Grid Margin="40">
        <Border Background="White" CornerRadius="20" MaxWidth="600" VerticalAlignment="Top">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.1"/>
            </Border.Effect>

            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                    <Ellipse Width="15" Height="15" Fill="#3F51B5" Margin="0,0,10,0"/>
                    <TextBlock Text="Registrar Captura" FontSize="22" FontWeight="Bold" Foreground="#212121"/>
                </StackPanel>

                <TextBlock Text="Selecione o Pokémon (Pokédex)" FontSize="12" FontWeight="Bold" Foreground="#3F51B5" Margin="5,0,0,5"/>
                <Border Background="#F0F2F5" CornerRadius="10" Padding="10,2">
                    <ComboBox BorderThickness="0" Background="Transparent" Height="38"
                              ItemsSource="{Binding PokedexList}" 
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedPokedexEntry}"/>
                </Border>

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Nature (Personalidade)" FontSize="12" FontWeight="Bold" Foreground="#3F51B5" Margin="5,0,0,5"/>
                        <Border Background="#F0F2F5" CornerRadius="10" Padding="10,2">
                            <ComboBox BorderThickness="0" Background="Transparent" Height="38"
                                      ItemsSource="{Binding NaturesList}"
                                      DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedNature}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Nível Atual" FontSize="12" FontWeight="Bold" Foreground="#3F51B5" Margin="5,0,0,5"/>
                        <Border Background="#F0F2F5" CornerRadius="10" Padding="15,5">
                            <TextBox BorderThickness="0" Background="Transparent" FontSize="16" 
                                     Text="{Binding NewPokemon.Level}"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Treinador Responsável" FontSize="12" FontWeight="Bold" Foreground="#3F51B5" Margin="5,20,0,5"/>
                <Border Background="#F0F2F5" CornerRadius="10" Padding="10,2">
                    <ComboBox BorderThickness="0" Background="Transparent" Height="38"
                              ItemsSource="{Binding TrainersList}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedTrainer}"/>
                </Border>

                <Button Content="FINALIZAR REGISTRO" 
                        Style="{StaticResource PokemonButtonStyle}" 
                        Margin="0,40,0,0" Height="55"
                        Command="{Binding SavePokemonCommand}"/>

                <TextBlock Text="{Binding StatusMessage}" Foreground="#4CAF50" Margin="0,15,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>